# Gencraft Studio - Standard .gitignore (v1.0)
# This file is part of gct-repo-template-standard and should be the base for all new repositories.

# Node.js
# Dependencies are managed by package managers, do not commit them.
node_modules/
# Build output
dist/
build/
# Logs
*.log
npm-debug.log*
yarn-error.log*

# Python
# Cache and compiled files
__pycache__/
*.py[cod]
# Virtual environments
.venv/
venv/
env/

# Sensitive Environment Variables
# NEVER commit .env files. Use a .env.example as a template if needed.
.env
.env.local
.env.*.local

# OS & Editor Specific
# macOS
.DS_Store
# Vim
*~
*.swp
# VSCode
.vscode/

# Java (for completeness)
*.class
*.jar

# Godot (ENG-ADR-089)
# Commit .godot/global_script_class_cache.cfg + .godot/.gdignore so the headless
# GUT runner has the class registry at startup (no editor scan in CI).
# Everything else under .godot/ is machine-specific and regenerated on import.
.godot/editor/
.godot/uid_cache.bin
.godot/imported/
*.import
# Godot addons populated from vendor/ — not tracked, regenerated by ./onboard.sh
# (GUT is a git submodule at vendor/gut, copied into addons/gut on setup).
addons/gut
# GUT test output
test-results/
# Agent planning scratch (never commit)
.planning/
