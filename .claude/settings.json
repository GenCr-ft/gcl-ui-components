{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lgan/hxgn/dev/claude/exp/gcs-plt-gemop/hooks/git-safety-check.sh",
            "timeout": 5,
            "statusMessage": "🛡️ Git Safety: checking for force-push to protected branches...",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/lgan/hxgn/dev/claude/exp/gcs-plt-gemop/hooks/date-updater.py",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
