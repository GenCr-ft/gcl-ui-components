# Gencraft Studio — Official EditorConfig Standard
# SSoT: gcs-devops-standards/domains/tooling/standards/template/.editorconfig_standard
root = true

# ===============================================
# Universal Settings
# ===============================================
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ===============================================
# Language-Specific Overrides
# ===============================================

[*.py]
indent_size = 4

[*.{cs,c,cpp,h,hpp}]
indent_size = 4

[*.{js,jsx,ts,tsx}]

[*.html]

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
